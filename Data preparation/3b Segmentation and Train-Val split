def normalize_whitespace(text):
    text = re.sub(r'[ \t]+', ' ', text)
    text = re.sub(r'\n{3,}', '\n\n', text)

    return "\n".join(line.rstrip() for line in text.splitlines()).strip()


def is_address_line(line):
    s = line.strip()

    if not s:
        return False

    letters = [c for c in s if c.isalpha()]
    ratio = sum(c.isupper() for c in letters) / len(letters) if letters else 0.0

    return ratio > 0.6 or bool(ADDRESS_LIKE_RX.search(s))


def drop_address_blocks(text):
    lines = text.splitlines()
    kept = []
    i = 0

    while i < len(lines):
        block = lines[i:i + 3]

        if len(block) >= 2 and all(is_address_line(l) for l in block):
            i += len(block)
            continue

        if is_address_line(lines[i]) and (i == 0 or not lines[i - 1].strip()):
            i += 1
            continue

        kept.append(lines[i])
        i += 1

    return "\n".join(kept)


def drop_noise_lines(text):
    text = "\n".join(
        line for line in text.splitlines()
        if not any(pattern.match(line) for pattern in DROP_LINE_PATTERNS)
    )

    return drop_address_blocks(text)


def remove_bio_tables(text):
    lines = []
    in_table = False

    for line in text.splitlines():
        if BIO_ANALYTE_RX.match(line):
            in_table = True
            continue

        if in_table:
            if not line.strip() or re.match(r'^[A-Z][A-Za-zÀ-ÿ\s]+\s*:', line):
                in_table = False
            elif re.match(r'^\s*[\w\s()°/]+\s*[:(¦|]?\s*[\d.,<>]+', line):
                continue

        lines.append(line)

    return "\n".join(lines)


def remove_pure_med_lists(text):
    result = []
    in_list = False
    buffer = []

    for line in text.splitlines():
        if MED_LIST_HEADER_RX.match(line):
            in_list = True
            buffer = [line]
            continue

        if in_list:
            if PURE_MED_LINE_RX.match(line) or not line.strip():
                buffer.append(line)
                continue

            has_narrative = any(
                len(l.split()) > 6 and not PURE_MED_LINE_RX.match(l)
                for l in buffer if l.strip()
            )

            if has_narrative:
                result.extend(buffer)

            in_list = False
            buffer = []

        result.append(line)

    return "\n".join(result)


def starts_with_document_header(content):
    for line in content.strip().splitlines()[:5]:
        line = line.strip()

        if not line:
            continue

        if any(pattern.match(line) for pattern in DOCUMENT_HEADER_PATTERNS):
            return True

    return False


def get_section_category(line):
    for category, patterns in SECTION_TITLES.items():
        for pattern in patterns:
            if re.match(pattern, line, re.IGNORECASE):
                return category

    return None


def is_evolution_title(title):
    return bool(re.match(
        r"^\s*[ÉE]VOLUTION(\s+DANS\s+LE\s+SERVICE)?\s*:?\s*$",
        title, re.IGNORECASE
    ))


def is_observations_medicales_title(title):
    return bool(re.match(
        r"^\s*OBSERVATIONS?\s+M[ÉE]DICALES?\s*:?\s*$", title, re.IGNORECASE
    ))


def finalise_section(title, raw_content, category):
    content = normalize_whitespace(drop_noise_lines(raw_content))

    return {
        "title": title.strip(),
        "category": category,
        "content": content,
        "content_length": len(content),
        "is_false_positive": starts_with_document_header(content),
    }


def detect_sections_edsnlp(text):
    try:
        spans = SECTION_NLP(text).spans.get("sections", [])
    except Exception:
        return []

    sections = []

    for span in spans:
        category = EDSNLP_CATEGORY.get(getattr(span, "label_", "").lower())

        if category is None:
            continue

        parts = span.text.split("\n", 1)

        sections.append(
            finalise_section(
                parts[0], parts[1] if len(parts) > 1 else "", category
            )
        )

    return sections


def detect_sections_regex(text):
    lines = text.splitlines()
    markers = []

    for i, line in enumerate(lines):
        category = get_section_category(line)

        if category:
            markers.append({
                "title": line.strip(),
                "category": category,
                "line_idx": i,
            })

    sections = []

    for j, marker in enumerate(markers):
        idx = marker["line_idx"]
        line = lines[idx]
        start_line = idx + 1
        inline_first_line = None
        title = marker["title"]

        m_inline = re.match(
            r"^\s*([ÉE]VOLUTION\s+DANS\s+LE\s+SERVICE)\s*:?\s*(.*)$",
            line, flags=re.IGNORECASE
        )

        if m_inline:
            title = m_inline.group(1).strip()

            if m_inline.group(2).strip():
                inline_first_line = line.strip()

        end_line = (
            markers[j + 1]["line_idx"] if j + 1 < len(markers) else len(lines)
        )

        content_lines = lines[start_line:end_line]

        if inline_first_line is not None:
            content_lines = [inline_first_line] + content_lines

        sections.append(
            finalise_section(
                title, "\n".join(content_lines), marker["category"]
            )
        )

    return sections


def detect_sections(text):
    sections = detect_sections_edsnlp(text)

    if sections:
        return sections

    return detect_sections_regex(text)


def has_postop_content(sections, min_length=5):
    return any(
        sec["category"] == "postop"
        and sec["content_length"] > min_length
        and not sec["is_false_positive"]
        for sec in sections
    )


def get_prescription_sortie_content(sections, min_length=5):
    for sec in sections:
        if (
            sec["category"] == "prescription_sortie"
            and sec["content_length"] > min_length
            and not sec["is_false_positive"]
        ):
            return sec["content"]

    return None


def extract_postop_sections(sections):
    evolution_present = any(
        sec["category"] == "postop"
        and not sec["is_false_positive"]
        and is_evolution_title(sec["title"])
        for sec in sections
    )

    blocks = []
    seen_postop = False

    for sec in sections:
        if sec["is_false_positive"] or sec["content_length"] == 0:
            continue

        if sec["category"] == "postop":
            if evolution_present and is_observations_medicales_title(sec["title"]):
                continue

            seen_postop = True

        elif sec["category"] in NEUTRAL_CATEGORIES:
            if not seen_postop:
                continue

        else:
            continue

        title = sec["title"].strip()
        content = sec["content"]

        if title and not content.upper().startswith(title.upper()):
            blocks.append(title + "\n" + content if content else title)
        else:
            blocks.append(content)

    return "\n\n".join(blocks)


def extract_by_keywords(text):
    earliest = None

    for pattern in KEYWORD_TRIGGERS:
        for m in re.finditer(pattern, text):
            if earliest is None or m.start() < earliest:
                earliest = m.start()

    if earliest is None:
        return None

    line_start = text.rfind('\n', 0, earliest)
    line_start = 0 if line_start == -1 else line_start + 1

    return text[line_start:].strip()


def segment_sentences(text):
    if not text:
        return []

    try:
        return [
            {
                "id": f"S{i}",
                "start": sent.start_char,
                "end": sent.end_char,
                "text": sent.text.strip(),
            }
            for i, sent in enumerate(SENT_NLP(text).sents)
            if sent.text.strip() and len(sent.text.strip()) > 2
        ]
    except Exception:
        pass

    sentences = []
    pos = 0

    for i, part in enumerate(
        re.split(r'(?<=[\.\!\?;])\s+(?=[A-ZÉÈÊÂÀÔÎÙÛÇ0-9\-])', text)
    ):
        part = part.strip()

        if part and len(part) > 2:
            sentences.append({
                "id": f"S{i}",
                "start": pos,
                "end": pos + len(part),
                "text": part,
            })

        pos += len(part) + 1

    return sentences


def segment_cr_with_metadata(text):
    empty = {
        "cr_text_cleaned": "",
        "sentences_json": "[]",
        "original_length": len(text) if isinstance(text, str) else 0,
        "cleaned_length": 0,
        "reduction_percent": 100.0,
    }

    if not isinstance(text, str) or not text:
        return dict(empty, segmentation_method="empty_input",
                    reduction_percent=0.0)

    original_length = len(text)

    if DOC_IMPOR_RX.search(text):
        return dict(empty, segmentation_method="doc_import")

    text = SEG_HEADER_BLOCK_RX.sub("", text)
    text = text.replace('\u00A0', ' ').replace('\r\n', '\n').replace('\r', '\n')

    text_cleaned = normalize_whitespace(drop_noise_lines(text))

    if not text_cleaned:
        return dict(empty, segmentation_method="empty_after_cleaning")

    sections = detect_sections(text)

    if has_postop_content(sections):
        method = "postop_sections"
        result = extract_postop_sections(sections)
    else:
        prescription = get_prescription_sortie_content(sections)

        if prescription:
            method = "prescription_sortie_fallback"
            result = "PRESCRIPTION DE SORTIE\n" + prescription
        else:
            triggered = extract_by_keywords(text_cleaned)

            if triggered:
                method = "keyword_fallback"
                result = triggered
            else:
                method = "full_text_fallback"
                result = text_cleaned

    result = normalize_whitespace(
        remove_pure_med_lists(remove_bio_tables(result))
    )

    return {
        "cr_text_cleaned": result,
        "sentences_json": json.dumps(
            segment_sentences(result), ensure_ascii=False
        ),
        "segmentation_method": method,
        "original_length": original_length,
        "cleaned_length": len(result),
        "reduction_percent": round(100 * (1 - len(result) / original_length), 1),
    }


def apply_segmentation(df):
    df = df.copy()

    results = df["cr_text_brut"].apply(segment_cr_with_metadata)

    for key in [
        "cr_text_cleaned", "sentences_json", "segmentation_method",
        "original_length", "cleaned_length", "reduction_percent",
    ]:
        df[key] = results.apply(lambda r, k=key: r[k])

    return df


def filter_strict(df, max_cd):
    df = df.copy()

    df = df[
        df["cr_text_cleaned"].astype(str).str.strip().str.len() > 0
    ].copy()

    df["cd_manuel"] = pd.to_numeric(df["cd_manuel"], errors="coerce")
    df = df[df["cd_manuel"].between(1, max_cd)].copy()
    df["cd_manuel"] = df["cd_manuel"].astype(int)

    exclus = df["fichier_cr"].astype(str).str.contains(
        "|".join(DOCS_A_EXCLURE), case=False, na=False
    )
    df = df[~exclus].copy()

    chirurgie = pd.to_datetime(df["date_chirurgie"], errors="coerce")
    rapport = pd.to_datetime(df["date_cr"], errors="coerce")

    df = df[chirurgie.notna() & rapport.notna()].copy()

    diff = (
        pd.to_datetime(df["date_cr"]) - pd.to_datetime(df["date_chirurgie"])
    ).dt.days

    return df[(diff >= 0) & (diff <= 90)].copy()


def make_group_split(df, target_classes, train_frac, random_state):
    rng = np.random.default_rng(random_state)

    counts = (
        df.groupby(["patient_id", "cd_manuel"]).size().unstack(fill_value=0)
    )

    for c in [1, 2, 3, 4, 5]:
        if c not in counts.columns:
            counts[c] = 0

    counts = counts[[1, 2, 3, 4, 5]]

    total_per_class = counts.sum(axis=0).to_dict()

    targets = {
        c: int(np.round(total_per_class[c] * (1 - train_frac)))
        for c in target_classes
    }

    target_val_samples = int(np.round((1 - train_frac) * len(df)))

    patients = list(counts.index)
    rng.shuffle(patients)

    val_patients = set()
    train_patients = set(patients)

    val_counts = {c: 0 for c in target_classes}
    val_samples = 0

    def score(current):
        return sum((current[c] - targets[c]) ** 2 for c in target_classes)

    current_score = score(val_counts)

    while True:
        best_pid = None
        best_score = current_score
        best_delta = 0
        best_counts = None

        for pid in list(train_patients):
            vector = counts.loc[pid]
            candidate = val_counts.copy()

            for c in target_classes:
                candidate[c] += int(vector[c])

            candidate_score = score(candidate)

            if candidate_score < best_score:
                best_score = candidate_score
                best_pid = pid
                best_delta = int(vector.sum())
                best_counts = candidate

        if best_pid is None:
            break

        val_patients.add(best_pid)
        train_patients.remove(best_pid)
        val_samples += best_delta
        val_counts = best_counts
        current_score = best_score

    if val_samples < target_val_samples:
        remaining = list(train_patients)
        rng.shuffle(remaining)

        for pid in remaining:
            val_patients.add(pid)
            train_patients.remove(pid)
            val_samples += int(counts.loc[pid].sum())

            if val_samples >= target_val_samples:
                break

    while val_samples > target_val_samples:
        candidates = list(val_patients)
        rng.shuffle(candidates)

        pid_remove = min(
            candidates,
            key=lambda pid: counts.loc[pid][list(target_classes)].sum()
        )

        val_patients.remove(pid_remove)
        train_patients.add(pid_remove)
        val_samples -= int(counts.loc[pid_remove].sum())

    train_df = df[df["patient_id"].isin(train_patients)].copy()
    val_df = df[df["patient_id"].isin(val_patients)].copy()

    assert not set(train_df["patient_id"]) & set(val_df["patient_id"])

    return train_df, val_df


def add_ccam_code(df, correspondance_path):
    corr = pd.read_csv(correspondance_path)
    corr["date_chirurgie"] = pd.to_datetime(corr["date_chirurgie"])

    corr = corr[["id_anonymise", "date_chirurgie", "ccam_code"]].rename(
        columns={"id_anonymise": "patient_id", "ccam_code": "major_surgery_ccam"}
    )

    corr = (
        corr.groupby(["patient_id", "date_chirurgie"])["major_surgery_ccam"]
        .agg(lambda x: x.iloc[0])
        .reset_index()
    )

    df = df.drop(columns=["major_surgery_ccam"], errors="ignore").copy()
    df["date_chirurgie"] = pd.to_datetime(df["date_chirurgie"])

    merged = pd.merge(df, corr, on=["patient_id", "date_chirurgie"], how="left")
    merged["major_surgery_ccam"] = merged["major_surgery_ccam"].fillna("N/A")

    return merged


def deduplicate(df):
    df = df.copy()
    df["date_chirurgie"] = pd.to_datetime(df["date_chirurgie"], errors="coerce")

    rows_to_drop = []

    for (pid, date_chir), group in df.groupby(["patient_id", "date_chirurgie"]):
        sources = list(group["source"].unique())

        if len(sources) < 2:
            continue

        disagreement = False

        for fichier in group["fichier_cr"].unique():
            block = group[group["fichier_cr"] == fichier]

            if len(block) > 1:
                grades = block.groupby("source")["cd_manuel"].first().to_dict()

                if len(set(grades.values())) > 1:
                    disagreement = True

        if disagreement and ANNOTATEUR_PRIORITAIRE in sources:
            keep = ANNOTATEUR_PRIORITAIRE
        else:
            keep = sorted(sources)[0]

        mask = (
            (df["patient_id"] == pid)
            & (df["date_chirurgie"] == date_chir)
            & (df["source"] != keep)
        )

        rows_to_drop.extend(df[mask].index.tolist())

    return df.drop(index=rows_to_drop)


segmented_df = apply_segmentation(reports_df)

filtered_df = filter_strict(segmented_df, max_cd=5)

train_df, val_df = make_group_split(
    filtered_df,
    target_classes=TARGET_CLASSES,
    train_frac=TRAIN_FRAC,
    random_state=RANDOM_STATE,
)

OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

for name, split_df in [("train", train_df), ("val", val_df)]:
    split_df = add_ccam_code(split_df, CORRESPONDANCE_PATH)
    split_df = deduplicate(split_df)

    split_df.to_csv(OUTPUT_DIR / f"{name}_cd1to5.csv", index=False)
