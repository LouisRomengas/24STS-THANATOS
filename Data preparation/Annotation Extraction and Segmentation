def normalize_whitespace(text):
    text = re.sub(r'[ \t]+', ' ', text)
    text = re.sub(r'\n{3,}', '\n\n', text)

    return "\n".join(line.rstrip() for line in text.splitlines()).strip()


def clean_text_basic(text):
    if not text:
        return ""

    text = text.replace('\u00A0', ' ').replace('\r\n', '\n').replace('\r', '\n')
    text = HEADER_BLOCK_RX.sub("", text)
    text = "\n".join(
        line for line in text.splitlines() if not HEADER_LINE_RX.match(line)
    )
    text = ADMIN_INLINE_RX.sub("", text)
    text = "\n".join(
        line for line in text.splitlines()
        if not ADMIN_LINE_RX.match(line) and not SEPARATOR_RX.match(line)
    )

    def is_address(line):
        s = line.strip()

        if not s:
            return False

        letters = [c for c in s if c.isalpha()]
        ratio = sum(c.isupper() for c in letters) / len(letters) if letters else 0.0

        return ratio > 0.6 or bool(ADDRESS_LIKE_RX.search(s))

    lines = text.splitlines()
    cleaned = []
    i = 0

    while i < len(lines):
        block = lines[i:i + 3]

        if len(block) >= 2 and all(is_address(l) for l in block):
            i += len(block)
            continue

        if is_address(lines[i]) and (i == 0 or not lines[i - 1].strip()):
            i += 1
            continue

        cleaned.append(lines[i])
        i += 1

    text = re.sub(r'https?://\S+', '', "\n".join(cleaned).strip())

    return normalize_whitespace(text)


def extract_sections(text):
    if HAS_EDSNLP and SECTION_NLP is not None:
        try:
            doc = SECTION_NLP(text)
            sections = [
                {
                    "name": span.label_.lower() if hasattr(span, 'label_')
                            else "unknown",
                    "start": span.start_char,
                    "end": span.end_char,
                    "text": span.text,
                }
                for span in doc.spans.get("sections", [])
            ]

            if sections:
                return sections
        except Exception:
            pass

    sections = []
    current_section = None
    current_start = 0
    current_lines = []
    pos = 0

    for line in text.splitlines():
        matched = None

        for pattern, name in SECTION_PATTERNS:
            if re.match(pattern, line):
                matched = name
                break

        if matched:
            if current_section and current_lines:
                sections.append({
                    "name": current_section,
                    "start": current_start,
                    "end": pos,
                    "text": "\n".join(current_lines),
                })

            current_section = matched
            current_start = pos
            current_lines = []
        else:
            current_lines.append(line)

        pos += len(line) + 1

    if current_section and current_lines:
        sections.append({
            "name": current_section,
            "start": current_start,
            "end": pos,
            "text": "\n".join(current_lines),
        })

    return sections


def extract_postop_by_keywords(text):
    earliest = None

    for pattern in KEYWORD_TRIGGERS:
        for m in re.finditer(pattern, text):
            if earliest is None or m.start() < earliest:
                earliest = m.start()

    if earliest is None:
        return text

    line_start = text.rfind('\n', 0, earliest)
    line_start = 0 if line_start == -1 else line_start + 1

    return text[line_start:].strip()


def extract_postop_by_sections(text):
    sections = extract_sections(text)

    if not sections:
        return extract_postop_by_keywords(text)

    sections.sort(key=lambda x: x["start"])

    kept = []
    seen_postop = False

    for section in sections:
        name = section["name"].lower()

        if name in SECTIONS_TO_SKIP:
            continue

        if name in POSTOP_SECTIONS_TO_KEEP:
            kept.append(section)
            seen_postop = True
        elif name in NEUTRAL_SECTIONS and seen_postop:
            kept.append(section)

    if not kept:
        return extract_postop_by_keywords(text)

    return "\n\n".join(
        section["text"].strip() for section in kept if section["text"].strip()
    )


def remove_bio_tables(text):
    lines = []
    in_table = False

    for line in text.splitlines():
        if BIO_TABLE_RX.match(line):
            in_table = True
            continue

        if in_table:
            if not line.strip() or re.match(r'^[A-Z][A-Za-zÀ-ÿ\s]+\s*:', line):
                in_table = False
            elif re.match(r'^\s*[\w\s()°/]+\s*[:(¦|]?\s*[\d.,<>]+', line):
                continue

        lines.append(line)

    return "\n".join(lines)


def remove_pure_med_lists(text):
    result = []
    in_list = False
    buffer = []

    for line in text.splitlines():
        if MED_LIST_HEADER_RX.match(line):
            in_list = True
            buffer = [line]
            continue

        if in_list:
            if PURE_MED_LINE_RX.match(line) or not line.strip():
                buffer.append(line)
                continue

            has_narrative = any(
                len(l.split()) > 6 and not PURE_MED_LINE_RX.match(l)
                for l in buffer if l.strip()
            )

            if has_narrative:
                result.extend(buffer)

            in_list = False
            buffer = []

        result.append(line)

    return "\n".join(result)


def segment_sentences(text):
    if not text:
        return []

    if HAS_EDSNLP and SENT_NLP is not None:
        try:
            doc = SENT_NLP(text)

            return [
                {
                    "id": f"S{i}",
                    "start": sent.start_char,
                    "end": sent.end_char,
                    "text": sent.text.strip(),
                }
                for i, sent in enumerate(doc.sents)
                if sent.text.strip() and len(sent.text.strip()) > 2
            ]
        except Exception:
            pass

    sentences = []
    pos = 0

    for i, part in enumerate(
        re.split(r'(?<=[\.\!\?;])\s+(?=[A-ZÉÈÊÂÀÔÎÙÛÇ0-9\-])', text)
    ):
        part = part.strip()

        if part and len(part) > 2:
            sentences.append({
                "id": f"S{i}",
                "start": pos,
                "end": pos + len(part),
                "text": part,
            })

        pos += len(part) + 1

    return sentences


def segment_postop_content(raw_text):
    if not raw_text:
        return "", []

    text = clean_text_basic(raw_text)
    text = extract_postop_by_sections(text)
    text = remove_bio_tables(text)
    text = remove_pure_med_lists(text)
    text = normalize_whitespace(text)

    return text, segment_sentences(text)


def parse_date(value):
    if not value:
        return None

    for fmt in ("%Y-%m-%d", "%d/%m/%Y", "%Y/%m/%d"):
        try:
            return datetime.strptime(value, fmt)
        except Exception:
            continue

    return None


def extract_cr_info_from_header(cr_text):
    header_lines = []

    for line in cr_text.split('\n'):
        if line.strip().startswith("===="):
            break

        header_lines.append(line)

    header_text = '\n'.join(header_lines)
    header_info = {}

    for key, pattern in HEADER_FIELDS.items():
        m = re.search(pattern, header_text)

        if m:
            header_info[key] = m.group(1).strip()

    for key in ("date_chirurgie", "date_rapport"):
        if key in header_info:
            header_info[key] = parse_date(header_info[key])

    return header_info


def parse_brat_file(ann_path):
    entities = []
    attributes = []

    try:
        lines = ann_path.read_text(encoding="utf-8").splitlines()
    except Exception:
        return entities, attributes

    for ln in lines:
        ln = ln.strip()

        if not ln:
            continue

        parts = ln.split("\t")

        if len(parts) < 2:
            continue

        if ln.startswith("T"):
            tinfo = parts[1].split()
            nums = [int(x) for x in re.findall(r"\d+", " ".join(tinfo[1:]))]

            if not nums:
                continue

            entities.append({
                "id": parts[0],
                "type": tinfo[0],
                "start": min(nums),
                "end": max(nums),
                "text": parts[2] if len(parts) > 2 else "",
            })

        elif ln.startswith("A"):
            ainfo = parts[1].split()

            if len(ainfo) < 3:
                continue

            attributes.append({
                "id": parts[0],
                "type": ainfo[0],
                "entity_id": ainfo[1],
                "value": ainfo[2],
            })

    return entities, attributes


def cd_grade_for_cr(entities, attributes):
    if not entities:
        return "1"

    attr_by_ent = defaultdict(dict)

    for a in attributes:
        if a["type"] in ("CD_Grade", "CD_Sous_Grade"):
            attr_by_ent[a["entity_id"]][a["type"]] = a["value"]

    for e in entities:
        if e["type"] == "DECES":
            return "5"

    cr_grade = "1"

    for e in entities:
        et = e["type"]

        if not et.startswith("TRAITEMENT_"):
            continue

        attrs = attr_by_ent.get(e["id"], {})

        if et == "TRAITEMENT_REANIMATION":
            grade = "4b" if attrs.get("CD_Sous_Grade", "a") == "b" else "4a"
        elif et in TRAITEMENTS_CD3:
            grade = "3b" if attrs.get("CD_Sous_Grade", "a") == "b" else "3a"
        elif et == "TRAITEMENT_MEDICAL":
            grade = "2" if attrs.get("CD_Grade", "I") == "II" else "1"
        else:
            continue

        if GRADE_ORDER.index(grade) > GRADE_ORDER.index(cr_grade):
            cr_grade = grade

    return cr_grade


def is_document_annule(text):
    if not isinstance(text, str):
        return False

    t = text.upper()

    return bool(DOC_ANNULE_RX.search(t)) and bool(ANNULE_RX.search(t))


def iter_patient_dirs(annotator_root):
    for entry in annotator_root.iterdir():
        if not entry.is_dir():
            continue

        if entry.name.startswith("nouveaux_patients_"):
            for inner in entry.iterdir():
                if inner.is_dir():
                    yield inner
        else:
            yield entry


