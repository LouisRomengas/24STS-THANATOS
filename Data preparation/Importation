def is_document_annule(note_text):
    if note_text is None:
        return True
    cleaned = re.sub(r'\s+', '', note_text.upper())
    return bool(re.search(r'DOCUMENTANNUL[EÉ]', cleaned))

spark.udf.register("is_document_annule_udf", is_document_annule, BooleanType())

