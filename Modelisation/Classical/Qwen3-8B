def scores(y_true, y_pred, detailed=False):
    y_true = np.asarray(y_true, dtype=int)
    y_pred = np.asarray(y_pred, dtype=int)
    severe_true = y_true >= 3
    severe_pred = y_pred >= 3
    denominator = int(severe_true.sum())

    result = {
        "accuracy": float(accuracy_score(y_true, y_pred)),
        "balanced_accuracy": float(balanced_accuracy_score(y_true, y_pred)),
        "macro_f1": float(f1_score(y_true, y_pred, average="macro", zero_division=0)),
        "weighted_f1": float(f1_score(y_true, y_pred, average="weighted", zero_division=0)),
        "kappa": float(cohen_kappa_score(y_true, y_pred)),
        "kappa_quadratic": float(cohen_kappa_score(y_true, y_pred, weights="quadratic")),
        "severe_sensitivity": float(
            (severe_true & severe_pred).sum() / denominator
        ) if denominator else 0.0,
    }

    if detailed:
        result["confusion_matrix"] = confusion_matrix(
            y_true,
            y_pred,
            labels=LABELS,
        ).tolist()
        result["classification_report"] = classification_report(
            y_true,
            y_pred,
            labels=LABELS,
            target_names=LABEL_NAMES,
            output_dict=True,
            zero_division=0,
        )

    return result


@torch.inference_mode()
def encode_documents(model, texts, batch_size):
    tokenizer = model.tokenizer
    dimension = model.get_sentence_embedding_dimension() * 2
    embeddings = []

    for text in texts:
        sentences = [
            sentence.strip()
            for sentence in re.split(
                r"(?<=[\.\!\?;:])\s+|\n+",
                str(text).strip(),
            )
            if sentence.strip()
        ]

        chunks = []
        current = []
        current_tokens = 0

        for sentence in sentences:
            token_ids = tokenizer.encode(
                sentence,
                add_special_tokens=False,
            )

            if len(token_ids) > 2048:
                if current:
                    chunks.append(" ".join(current).strip())
                    current = []
                    current_tokens = 0

                for start in range(0, len(token_ids), 2048):
                    chunk = tokenizer.decode(
                        token_ids[start:start + 2048],
                        skip_special_tokens=True,
                    ).strip()

                    if chunk:
                        chunks.append(chunk)

            elif current_tokens + len(token_ids) <= 2048:
                current.append(sentence)
                current_tokens += len(token_ids)

            else:
                if current:
                    chunks.append(" ".join(current).strip())

                current = [sentence]
                current_tokens = len(token_ids)

        if current:
            chunks.append(" ".join(current).strip())

        if not chunks:
            embeddings.append(np.zeros(dimension, dtype=np.float32))
            continue

        chunk_embeddings = model.encode(
            chunks,
            batch_size=batch_size,
            convert_to_numpy=True,
            show_progress_bar=False,
        )

        embeddings.append(
            np.concatenate(
                [
                    chunk_embeddings.mean(axis=0),
                    chunk_embeddings.max(axis=0),
                ]
            ).astype(np.float32)
        )

    return np.vstack(embeddings)


def run(text_col, tag, model, batch_size, n_bootstrap):
    train = pd.read_csv(
        TRAIN_PATH,
        usecols=["patient_id", text_col, "cd_manuel"],
    )

    val = pd.read_csv(
        VAL_PATH,
        usecols=["patient_id", text_col, "cd_manuel"],
    )

    for df in (train, val):
        df[text_col] = df[text_col].fillna("").astype(str)
        df["patient_id"] = df["patient_id"].fillna("").astype(str).str.strip()
        df["cd_manuel"] = pd.to_numeric(df["cd_manuel"], errors="coerce")
        df.dropna(subset=["cd_manuel"], inplace=True)
        df.drop(df[~df["cd_manuel"].between(1, 5)].index, inplace=True)
        df.drop(df[df[text_col].str.strip().eq("")].index, inplace=True)
        df["cd_manuel"] = df["cd_manuel"].astype(int)

    assert not set(train["patient_id"]) & set(val["patient_id"])

    y_train = train["cd_manuel"].to_numpy(dtype=int)
    y_val = val["cd_manuel"].to_numpy(dtype=int)
    groups = train["patient_id"].to_numpy(dtype=object)

    result_dir = OUTPUT_DIR / f"text_{tag}"
    result_dir.mkdir(parents=True, exist_ok=True)

    tracker = OfflineEmissionsTracker(
        project_name="THANATOS",
        experiment_id=f"qwen3_embedding_{tag}",
        output_dir=str(result_dir),
        output_file="emissions.csv",
        log_level="critical",
        tracking_mode="process",
        country_iso_code="FRA",
    )

    tracker.start()
    start = time.perf_counter()

    X_train = encode_documents(
        model,
        train[text_col].tolist(),
        batch_size,
    )

    X_val = encode_documents(
        model,
        val[text_col].tolist(),
        batch_size,
    )

    X_train_knn = normalize(X_train, norm="l2")
    X_val_knn = normalize(X_val, norm="l2")

    scorer = make_scorer(
        cohen_kappa_score,
        weights="quadratic",
    )

    cv = StratifiedGroupKFold(
        n_splits=5,
        shuffle=True,
        random_state=42,
    )

    sample_weights = compute_sample_weight(
        class_weight="balanced",
        y=y_train,
    )

    model_results = {}
    comparison = []
    best_model = None
    best_score = -np.inf

    for name, (pipeline, param_grid) in MODELS.items():
        X_fit = X_train_knn if name == "knn" else X_train
        X_test = X_val_knn if name == "knn" else X_val

        grid = GridSearchCV(
            pipeline,
            param_grid=param_grid,
            scoring=scorer,
            cv=cv,
            n_jobs=-1,
            refit=True,
            verbose=0,
        )

        fit_kwargs = {}

        if name == "ordinal":
            fit_kwargs["classifier__sample_weight"] = sample_weights

        grid.fit(
            X_fit,
            y_train,
            groups=groups,
            **fit_kwargs,
        )

        pd.DataFrame(grid.cv_results_).to_csv(
            result_dir / f"grid_results_{name}.csv",
            index=False,
        )

        pred = grid.best_estimator_.predict(X_test)

        report = val.copy()
        report["cd_pred"] = pred
        report.to_csv(
            result_dir / f"val_predictions_cr_level_{name}.csv",
            index=False,
        )

        patient = (
            report.groupby("patient_id", as_index=False)
            .agg(
                cd_true_max=("cd_manuel", "max"),
                cd_pred_max=("cd_pred", "max"),
            )
        )

        patient.to_csv(
            result_dir / f"val_predictions_patient_level_{name}.csv",
            index=False,
        )

        rng = np.random.default_rng(42)
        bootstrap_cr = {key: [] for key in scores(y_val, pred)}
        bootstrap_patient = {
            key: []
            for key in scores(
                patient["cd_true_max"],
                patient["cd_pred_max"],
            )
        }

        for _ in range(n_bootstrap):
            idx = rng.integers(0, len(y_val), len(y_val))
            result = scores(y_val[idx], pred[idx])

            for key in bootstrap_cr:
                bootstrap_cr[key].append(result[key])

            idx_patient = rng.integers(
                0,
                len(patient),
                len(patient),
            )
            result = scores(
                patient["cd_true_max"].to_numpy()[idx_patient],
                patient["cd_pred_max"].to_numpy()[idx_patient],
            )

            for key in bootstrap_patient:
                bootstrap_patient[key].append(result[key])

        bootstrap_cr = {
            key: {
                "mean": float(np.nanmean(value)),
                "std": float(np.nanstd(value, ddof=1)),
                "ci95_low": float(np.nanpercentile(value, 2.5)),
                "ci95_high": float(np.nanpercentile(value, 97.5)),
                "n_bootstrap": n_bootstrap,
            }
            for key, value in bootstrap_cr.items()
        }

        bootstrap_patient = {
            key: {
                "mean": float(np.nanmean(value)),
                "std": float(np.nanstd(value, ddof=1)),
                "ci95_low": float(np.nanpercentile(value, 2.5)),
                "ci95_high": float(np.nanpercentile(value, 97.5)),
                "n_bootstrap": n_bootstrap,
            }
            for key, value in bootstrap_patient.items()
        }

        cr_metrics = scores(
            y_val,
            pred,
            detailed=True,
        )

        patient_metrics = scores(
            patient["cd_true_max"],
            patient["cd_pred_max"],
            detailed=True,
        )

        model_results[name] = {
            "best_params": grid.best_params_,
            "best_cv_kappa_quadratic": float(grid.best_score_),
            "val_cr_level": cr_metrics,
            "val_patient_level": patient_metrics,
            "bootstrap_val_cr_level": bootstrap_cr,
            "bootstrap_val_patient_level": bootstrap_patient,
        }

        comparison.append(
            {
                "model": name,
                "cv_kappa_quadratic": float(grid.best_score_),
                "val_cr_kappa_quadratic": cr_metrics["kappa_quadratic"],
                "val_patient_kappa_quadratic": patient_metrics["kappa_quadratic"],
                "val_patient_balanced_accuracy": patient_metrics["balanced_accuracy"],
                "val_patient_macro_f1": patient_metrics["macro_f1"],
            }
        )

        if grid.best_score_ > best_score:
            best_score = float(grid.best_score_)
            best_model = name

    tracker.stop()
    wall_seconds = time.perf_counter() - start

    pd.DataFrame(comparison).to_csv(
        result_dir / "all_classifiers_comparison.csv",
        index=False,
    )

    emissions = {}
    emissions_path = result_dir / "emissions.csv"

    if emissions_path.exists():
        energy = pd.read_csv(emissions_path)

        if not energy.empty:
            row = energy.iloc[-1]
            emissions = {
                "duration_seconds": float(row.get("duration", 0)),
                "energy_kwh": float(row.get("energy_consumed", 0)),
                "emissions_kg_co2eq": float(row.get("emissions", 0)),
            }

    summary = {
        "train_csv": str(TRAIN_PATH),
        "external_test_csv": str(VAL_PATH),
        "text_col": text_col,
        "embedding_model": MODEL_ID,
        "context_window_tokens": 8192,
        "chunk_tokens": 2048,
        "chunking": "sentence_boundaries",
        "pooling": "mean_plus_max_concatenation",
        "embedding_dimension": int(X_train.shape[1]),
        "clinical_context": "text_only",
        "classifiers": {
            "logistic": {
                "standard_scaling": True,
                "class_weight": "balanced",
            },
            "svm": {
                "standard_scaling": True,
                "class_weight": "balanced",
            },
            "random_forest": {
                "class_weight": "balanced",
            },
            "ordinal_logistic_regression": {
                "sample_weight": "inverse_class_frequency",
            },
            "knn": {
                "k": [1, 3, 5, 7, 11, 15, 21],
                "metric": "cosine",
                "l2_normalized_embeddings": True,
                "weights": ["uniform", "distance"],
            },
        },
        "model_selection": {
            "cv": "StratifiedGroupKFold",
            "n_splits": 5,
            "group": "patient_id",
            "criterion": "quadratic_weighted_kappa",
            "best_model": best_model,
            "best_cv_kappa_quadratic": best_score,
        },
        "models": model_results,
        "wall_seconds": float(wall_seconds),
        "energy": emissions,
    }

    (result_dir / "paper_summary.json").write_text(
        json.dumps(summary, indent=2, ensure_ascii=False),
        encoding="utf-8",
    )


parser = argparse.ArgumentParser()
parser.add_argument(
    "--text_cols",
    nargs="+",
    default=["cleaned", "raw"],
    choices=["cleaned", "raw"],
)
parser.add_argument("--batch_size", type=int, default=4)
parser.add_argument("--n_bootstrap_val", type=int, default=1000)
args = parser.parse_args()

device = "cuda" if torch.cuda.is_available() else "cpu"

model = SentenceTransformer(
    MODEL_ID,
    device=device,
)

model.max_seq_length = 8192

columns = {
    "cleaned": "cr_text_cleaned",
    "raw": "cr_text_brut",
}

for text_key in args.text_cols:
    run(
        columns[text_key],
        text_key,
        model,
        args.batch_size,
        args.n_bootstrap_val,
    )
